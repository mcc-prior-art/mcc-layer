# Python
__pycache__/
*.py[cod]

# Audit-chain inter-process lock sidecar files (src/mcc_core/audit.py::AuditLog),
# created next to whatever audit log path is in use (e.g. audit.jsonl.lock).
# Runtime lock state only -- never meaningful to commit.
*.jsonl.lock

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# Redis' own default dump file, written to cwd by a local redis-server
# process used by the Redis-gated test suites -- runtime state, never
# meaningful to commit.
dump.rdb

# Environments
.env
# Pilot env holds real keys/endpoints; the .example template IS committed.
.env.pilot
!.env.pilot.example
# PR #82: reference pilot integration env holds real keys/endpoints; the
# .example template IS committed.
.env.pilot-readiness
!.env.pilot-readiness.example
.venv/
venv/

# Secrets / private keys — never commit signing-key material.
# Narrowly scoped to private-key file types and the filenames this repo
# generates (scripts/generate_signing_key.py -> mcc_signing_key.pem). Public
# keys are distributed as base64 in JSON/printed output, not as .pem, so these
# do not hide any legitimate public-key artifact or source file.
*.pem
*.key
id_ed25519
mcc_signing_key.pem

# OS
.DS_Store

# Python build artifacts (PR #40 packaging)
build/
dist/
/mcc_core.egg-info/

# Generated evidence bundles (compliance + interoperability); regenerated in CI
/artifacts/

# TLC (PR #71 Workstream I): downloaded tool jar + model-checking scratch state,
# never vendored -- model/run_tlc.sh fetches tla2tools.jar deterministically.
/model/tools/
/model/states/
