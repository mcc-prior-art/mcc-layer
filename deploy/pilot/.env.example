# Copy to deploy/pilot/.env and set real values. DO NOT commit .env.
# Only API keys live here; signing keys are PEM files under ./secrets (generated
# by generate_pilot_config.py) and are mounted, never placed in environment vars.
#
# SERVICE-SPECIFIC SECRET ALLOCATION — read before editing docker-compose.yml:
# this file is a flat list for operator convenience, but no service in
# docker-compose.yml should ever receive it via a blanket `env_file:`. Each
# service's `environment:` block pulls in by name ONLY the variables that
# service's own code actually reads:
#   mcc-gateway        -> MCC_GATEWAY_API_KEY, MCC_GATEWAY_OPERATOR_API_KEY
#   mcc-egress-proxy    -> MCC_EGRESS_API_KEY, MCC_EGRESS_OPERATOR_API_KEY,
#                          credential-reference vars below (if configured)
#   reference-egress-agent -> MCC_EGRESS_API_KEY ONLY. It must NEVER receive
#                          MCC_EGRESS_OPERATOR_API_KEY, MCC_GATEWAY_OPERATOR_API_KEY,
#                          or any upstream credential — the agent proposes;
#                          only an independent operator may approve an
#                          ESCALATE. A prior revision of docker-compose.yml
#                          gave this agent every variable in this file via
#                          `env_file:`; that was fixed (see
#                          docs/CONSTITUTION-INVARIANTS.md INV-06/INV-10 for
#                          the underlying principle: the agent/intelligence
#                          plane must not hold privileged-plane credentials).
#                          If this deployment ran with that older
#                          docker-compose.yml, rotate MCC_GATEWAY_OPERATOR_API_KEY
#                          and MCC_EGRESS_OPERATOR_API_KEY now — the agent
#                          container held them even if its own code never
#                          used them.

# Agent API key (X-API-Key) — propose / verify / execute.
MCC_GATEWAY_API_KEY=change-me-agent-key

# Operator API key (X-Operator-Key) — approve / deny / revoke / trust admin.
# Leave empty to disable ALL operator actions (fail-closed). Held ONLY by
# mcc-gateway's own environment — never by an agent container.
MCC_GATEWAY_OPERATOR_API_KEY=change-me-operator-key

# Enforced egress proxy: agent X-API-Key (and the reference agent uses the same).
MCC_EGRESS_API_KEY=change-me-egress-key
# Operator key for egress ESCALATE approvals (empty disables them, fail-closed).
# Held ONLY by mcc-egress-proxy's own environment — never by an agent container.
MCC_EGRESS_OPERATOR_API_KEY=change-me-egress-operator-key

# Credential references (optional). "none" disables; "env" reads raw values from
# the env vars named in MCC_EGRESS_CREDENTIAL_CONFIG (a secret-free JSON mapping).
# MCC_EGRESS_CREDENTIAL_PROVIDER=env
# MCC_EGRESS_CREDENTIAL_CONFIG=/secrets/credentials.json
# Raw secret VALUES go here (git-ignored .env), referenced by name from the config:
# MCC_EGRESS_CRED_EXAMPLE_API=Bearer change-me
# MCC_EGRESS_MTLS_CERT=/secrets/client.crt
# MCC_EGRESS_MTLS_KEY=/secrets/client.key
# MCC_EGRESS_CA_BUNDLE=/secrets/ca.pem

# Optional: per-operation Redis timeouts (defaults are conservative).
# MCC_REDIS_OP_TIMEOUT_SECONDS=0.5
# MCC_REDIS_CONNECT_TIMEOUT_SECONDS=1.0
