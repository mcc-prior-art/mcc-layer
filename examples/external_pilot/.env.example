# External Pilot Integration Pack — environment template.
#
# The fresh-clone quick start (run_external_pilot_self_check.py) needs
# NONE of this — it is fully in-memory, zero-credential, zero-network.
# This file documents what a REAL deployment (your own agent + your own
# actuator, real durable state) would configure. Copy to `.env`, fill in
# real values, and NEVER commit the filled-in file (`.env` is already
# covered by this repository's standard gitignore conventions for
# secrets — verify before committing).
#
# Fail-closed by construction: examples.external_pilot.server.build_external_pilot_app
# raises ExternalPilotConfigError if tenants_credentials / tenants_authority /
# upstream are not explicitly supplied — there is no code path that
# silently falls back to demo credentials or demo authority for a real
# deployment. Missing configuration is refused, never a silently-enabled
# permissive default.

# --- Caller authentication (REQUIRED for a real deployment) ---
# JSON object: {"<api-key>": "<tenant-id>"} — read via the EXISTING,
# unmodified gateway.proposal_api.tenants_from_env (the SAME variable
# every other governed HTTP surface in this repository already reads;
# examples.external_pilot.server.build_app_from_env reuses it directly,
# rather than inventing a pack-specific credential variable). Replace
# with your own real, secret API key(s); never reuse the literal demo
# values examples/external_pilot uses for its own zero-credential
# self-check outside local testing.
MCC_PROPOSAL_TENANTS={"replace-with-a-real-secret-api-key":"your-tenant-id"}

# --- Execution authority grants (REQUIRED for a real deployment) ---
# JSON object: {"<tenant-id>": {<constraints>}} — an unlisted tenant_id
# has ZERO authority (DENY by default). An empty object {} is a valid,
# explicit "grant nobody anything yet" configuration.
MCC_EXTERNAL_PILOT_AUTHORITY={"your-tenant-id":{}}

# --- Durable state backend (OPTIONAL) ---
# Unset / "memory" -> in-memory registries (single-process only; replay/
# tenant-isolation guarantees hold within one running process, not across
# restarts). "redis" -> real Redis-backed durable state (required for a
# genuine multi-instance or restart-safe deployment); requires MCC_REDIS_URL.
MCC_EXTERNAL_PILOT_BACKEND=memory
MCC_REDIS_URL=redis://127.0.0.1:6379/0

# --- Your actuator ---
# There is no environment variable for this: a real actuator is a Python
# object (gateway.proposal_execution_service.ResourceBoundUpstream) your
# deployment code constructs and passes to
# examples.external_pilot.server.build_external_pilot_app(upstream=...) —
# see actuator/demo_actuator.py for the template and
# docs/EXTERNAL_PILOT_INTEGRATION.md "How to connect your actuator" for
# the full contract. Never a string/URL configured here that MCC-Core
# would need to interpret itself.
