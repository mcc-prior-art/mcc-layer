# Deployable VoltAgent + MCC-Core pilot — configuration template.
#
#   cp .env.pilot.example .env.pilot   # then edit; .env.pilot is git-ignored
#
# Secrets are NOT committed. Signing / evaluator keys are PEM files generated
# into a private volume at first start (never placed in env vars). Only API keys
# and endpoints live here. Missing critical config fails closed (the gateway
# refuses to become ready).

# ---- API keys (agent vs operator boundary) --------------------------------- #
# SERVICE-SPECIFIC SECRET ALLOCATION: this file is a flat list for operator
# convenience, but docker-compose.pilot-voltagent.yml and
# docker-compose.pilot-clinic-voltagent.yml pull in by name ONLY the
# variables each service's own code reads — never via a blanket `env_file:`
# on voltagent-agent/clinic-agent. A prior revision of those compose files
# used `env_file: [.env.pilot]` on the agent service, which handed it
# MCC_GATEWAY_OPERATOR_API_KEY despite the comment below already saying it
# never should; that was fixed (see docs/CONSTITUTION-INVARIANTS.md
# INV-06/INV-10). If this deployment ran with that older compose file,
# rotate MCC_GATEWAY_OPERATOR_API_KEY now.
#
# Agent key: propose / evaluate / governed execute. CHANGE THESE for a real pilot.
MCC_GATEWAY_API_KEY=pilot-agent-key
# Operator key: approve / deny (ESCALATE). Held ONLY by the operator context
# (the gateway container), never by the VoltAgent agent. Empty disables all
# operator actions (fail-closed).
MCC_GATEWAY_OPERATOR_API_KEY=pilot-operator-key

# ---- Model provider -------------------------------------------------------- #
# Deterministic offline model by default (no paid API, no external network).
# Opt in to a real provider explicitly: set MCC_VOLTAGENT_MODEL_PROVIDER=openai,
# MCC_VOLTAGENT_MODEL=gpt-4o-mini, and provide OPENAI_API_KEY. Governance is
# independent of the model.
MCC_VOLTAGENT_MODEL_PROVIDER=deterministic
MCC_VOLTAGENT_MODEL=
# OPENAI_API_KEY=

# ---- Agent identity (not model-chosen) ------------------------------------- #
MCC_VOLTAGENT_ACTOR=agent/notify-bot
MCC_VOLTAGENT_RESOURCE=crm

# ---- Endpoints (in-cluster service DNS) ------------------------------------ #
MCC_GATEWAY_URL=http://mcc-gateway:8001
MCC_QUORUM_URL=http://evaluator-quorum:8080
MCC_REDIS_URL=redis://redis:6379/0
# The governed executor's target (reachable ONLY by the executor, not the agent).
MCC_UPSTREAM_BASE=http://external-service:9200

# ---- Governance runtime (fail-closed; do not weaken for the pilot) --------- #
MCC_GATEWAY_MODE=inline
MCC_REDIS_NAMESPACE=pilot
MCC_CONSENSUS_THRESHOLD=3
# Receipt-verifying governed executor: EXECUTED only on a confirmed receipt.
MCC_UPSTREAM_RECEIPT_VERIFY=1
# Execution timeout for the governed outbound call (seconds).
MCC_UPSTREAM_TIMEOUT=10

# ---- Persistent paths (mounted volumes; survive restart) ------------------- #
# Audit chain (authoritative, cryptographic) + generated key material.
MCC_GATEWAY_AUDIT_LOG_PATH=/data/audit.jsonl
MCC_PILOT_CONFIG_DIR=/config
MCC_PILOT_STATE_DIR=/pilot-state
